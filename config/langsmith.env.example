# Copy to config/langsmith.env (gitignored) and fill in your key:
#
#   cp config/langsmith.env.example config/langsmith.env
#   chmod 600 config/langsmith.env
#   $EDITOR config/langsmith.env        # paste the key here, not via `echo >>`
#                                       # (shell history keeps what you echo)
#
# scripts/run_daily.sh sources this file, so the scheduled launchd run picks it
# up without a plist edit. For interactive shells, add to ~/.zshrc:
#
#   [ -f "<project>/config/langsmith.env" ] && . "<project>/config/langsmith.env"
#
# Turn tracing off for a single run without editing anything:
#
#   CMC_LANGSMITH_TRACING=0 .venv/bin/python -m cmc.run

export CMC_LANGSMITH_TRACING=1
export LANGSMITH_API_KEY=lsv2_sk_REPLACE_ME
export LANGSMITH_PROJECT=chief-market-cat

# Region endpoint — MUST match the region your LangSmith account lives in.
# A key sent to the wrong region returns a bare 403 Forbidden, which looks
# exactly like an invalid key. Check the host in your smith.langchain.com URL.
#   US    https://api.smith.langchain.com        (SDK default)
#   EU    https://eu.api.smith.langchain.com
#   APAC  https://apac.api.smith.langchain.com
export LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
